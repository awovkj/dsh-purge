{
  "name": "dsh-purge-community",
  "version": "1.13.0",
  "description": "让 AI 更专注地辅助学习与动手实验：DSH 附加组件，提供状态自检、提示词与规则管理、本机备份与回滚。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json",
    "./presets-plugin": "./lib/presets-plugin.js",
    "./redteam/assessment": "./lib/redteam/awa-integration.js"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js",
    "purge-community": "bin/community.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md",
    "CONTRIBUTORS.md",
    "AGENTS.md",
    "!lib/redteam/assessment-engine/**/__pycache__/**",
    "!lib/redteam/assessment-engine/**/*.py[cod]",
    "!lib/redteam/assessment-engine/**/*.sqlite*",
    "!lib/redteam/assessment-engine/**/*.db*",
    "!lib/redteam/assessment-engine/**/.env",
    "!lib/redteam/assessment-engine/**/.env.*",
    "!lib/redteam/assessment-engine/**/projects/**",
    "!lib/redteam/assessment-engine/**/data/**",
    "!lib/redteam/assessment-engine/**/reports/**",
    "!lib/redteam/assessment-engine/**/tests_*.py"
  ],
  "scripts": {
    "build:client": "node packages/purge-panel/scripts/build.mjs --community",
    "check:client": "node packages/purge-panel/scripts/build.mjs --community --check",
    "build:modes": "node scripts/build-mode-presets.mjs",
    "check:modes": "node scripts/build-mode-presets.mjs --check",
    "build:market": "node scripts/build-market.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:assessment": "node scripts/sync-assessment-engine.mjs --check",
    "benchmark:tool-selection": "node scripts/check-tool-selection.mjs",
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "diagnose": "node bin/community.js diagnose",
    "smoke": "npm pack --ignore-scripts && node scripts/smoke.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "purge-community",
    "prompt-management",
    "rules",
    "agent",
    "backup",
    "rollback",
    "compatibility",
    "破甲",
    "jailbreak",
    "prompt-injection",
    "无限制模式",
    "unrestricted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingcharleslzy-ai/dsh-purge.git"
  },
  "homepage": "https://github.com/kingcharleslzy-ai/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/kingcharleslzy-ai/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/kingcharleslzy-ai/dsh-purge/releases/download/v1.13.0/dsh-purge-community-1.13.0.tgz",
      "git": "https://github.com/kingcharleslzy-ai/dsh-purge.git"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.1 <0.3.0",
      "profiles": [
        "desktop",
        "web"
      ],
      "dshReleases": {
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "unknown",
        "0.2.1-rc.5": "compatible",
        "0.2.2-alpha.2": "unknown",
        "0.2.2-rc.1": "source-adapted-unverified",
        "0.2.2-rc.3": "preset-loader-and-tool-catalog-verified-full-host-unverified"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.1 (host patch source target); 0.2.2-rc.3 (isolated preset Loader/tool catalog verified; full host and GUI unverified)",
  "contributors": [
    "小杨 / YuJunZhiXue (original dsh-purge author)",
    {
      "name": "luowang-ui",
      "url": "https://github.com/luowang-ui"
    },
    {
      "name": "heigit",
      "url": "https://github.com/heigit"
    },
    {
      "name": "OGHong",
      "url": "https://github.com/OGHong"
    },
    {
      "name": "loLollipop",
      "url": "https://github.com/loLollipop"
    },
    {
      "name": "youki258",
      "url": "https://github.com/youki258"
    },
    {
      "name": "SimonQvQ",
      "url": "https://github.com/SimonQvQ"
    }
  ],
  "author": {
    "name": "kingcharleslzy-ai",
    "url": "https://github.com/kingcharleslzy-ai"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "acorn": "8.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3"
  }
}
